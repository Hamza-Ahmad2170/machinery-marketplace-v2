{
	"name": "server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts"
		}
	},
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"dev": "dotenv -e .env -- tsx watch --clear-screen=false src/index.ts",
		"build": "tsdown",
		"start": "node --env-file-if-exists=.env dist/index.mjs",
		"typecheck": "tsc --noEmit",
		"auth:generate": "dotenv -e .env -- auth generate --config src/lib/auth.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "catalog:",
		"@hono/node-server": "catalog:",
		"@hono/zod-validator": "catalog:",
		"@repo/db": "workspace:*",
		"@repo/validators": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@hono/cli": "catalog:",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"auth": "catalog:",
		"dotenv-cli": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
