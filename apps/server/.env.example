PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/machinery_marketplace

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated origins allowed to call the API with cookies (web, admin, mobile scheme)
CORS_ORIGINS=http://localhost:3000

# Production only, when web and server are sibling subdomains: e.g. example.com
COOKIE_DOMAIN=
