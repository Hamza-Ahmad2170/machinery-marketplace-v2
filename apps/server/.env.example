# Copy to .env and fill in. The db scripts read this file.
DATABASE_URL=postgres://user:password@localhost:5432/machinery
PORT=3001
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated list of web app origins
CORS_ORIGINS=http://localhost:3000
# Optional. Set to share sessions across sibling subdomains, e.g. example.com
# COOKIE_DOMAIN=
