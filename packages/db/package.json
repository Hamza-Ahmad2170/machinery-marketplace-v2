{
	"name": "@repo/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./client": "./src/client.ts",
		"./env": "./src/env.ts",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"db:generate": "dotenv -e ../../apps/server/.env -- drizzle-kit generate",
		"db:migrate": "dotenv -e ../../apps/server/.env -- drizzle-kit migrate",
		"db:push": "dotenv -e ../../apps/server/.env -- drizzle-kit push",
		"db:studio": "dotenv -e ../../apps/server/.env -- drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@t3-oss/env-core": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"dotenv-cli": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:"
	}
}
