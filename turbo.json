{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": [
				"NODE_ENV",
				"DATABASE_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"CORS_ORIGINS",
				"COOKIE_DOMAIN",
				"API_URL"
			]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": ["node_modules/.cache/tsbuildinfo.json"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"//#check": {}
	}
}
